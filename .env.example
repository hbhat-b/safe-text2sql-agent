# Copy to .env and fill in your key:  cp .env.example .env
# Works with any OpenAI-compatible endpoint. Uncomment one provider block.

# --- OpenAI (default) ---
LLM_API_KEY=sk-your-key-here
LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL is not needed for OpenAI.

# --- Groq (free tier) ---
# LLM_API_KEY=gsk_your-key-here
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile

# --- Ollama (local, no key needed) ---
# Use http://localhost:11434/v1 when running the API outside Docker.
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_MODEL=llama3.1

# --- Optional ---
# LLM_TEMPERATURE=0.0
# Retries after a guardrail or database error before giving up.
# MAX_RETRIES=2
# Row cap the guardrail adds to every query.
# ROW_LIMIT=100
# Set by docker-compose; only change it when running locally with a different database.
# DB_PATH=data/chinook.sqlite
